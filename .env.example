# ==============================================================================
# A.S.T.R.A. System Configuration
# Automated Semantic Tracking and Retrieval Architecture
# SIH 2026 Problem Statement: SIH26227 / PS227
# ==============================================================================

# Server Environment (development | testing | production)
ASTRA_ENV=development

# Offline Operating Mode (Enforces zero runtime external API calls)
ASTRA_OFFLINE_MODE=true

# Host and Port Configuration
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8000
ASTRA_API_PREFIX=/api/v1

# CORS Origins (Comma-separated for local frontend)
ASTRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
ASTRA_LOG_LEVEL=INFO

# Storage Paths (Local directory paths for offline data and models)
ASTRA_DATA_DIR=data
ASTRA_RAW_DIR=data/raw
ASTRA_PROCESSED_DIR=data/processed
ASTRA_MANIFESTS_DIR=data/manifests
ASTRA_BENCHMARK_DIR=data/benchmark
ASTRA_MODELS_CACHE_DIR=models/staged
